{
  "info": {
    "name": "Nomi API",
    "description": "Manual checks that mirror the route tests. Set `baseUrl` and `accessToken` (run `npm run token` after filling DEMO_EMAIL/DEMO_PASSWORD) then run with the Postman CLI:\n\npostman collection run postman/Nomi.postman_collection.json --env-var baseUrl=http://localhost:3000 --env-var accessToken=<token>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "memoryId",
      "value": ""
    },
    {
      "key": "memoryVersion",
      "value": "1"
    },
    {
      "key": "conversationId",
      "value": "cccccccc-cccc-4ccc-8ccc-cccccccccccc"
    },
    {
      "key": "clientRequestId",
      "value": ""
    },
    {
      "key": "firstAssistantStatus",
      "value": ""
    },
    {
      "key": "firstAssistantTurnId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 ok:true', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.eql({ ok: true }); });",
                  "pm.test('no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Connections",
      "item": [
        {
          "name": "GET /api/connections (401 without token)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/api/connections"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));",
                  "pm.test('error shape', () => { const b = pm.response.json(); pm.expect(b.error.code).to.eql('unauthenticated'); pm.expect(b.requestId).to.match(/^req_/); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/connections",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/connections"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('no secrets', () => pm.expect(pm.response.text()).to.not.match(/sk-|service_role|eyJ/));",
                  "pm.test('has verification', () => pm.expect(pm.response.json().verification).to.be.oneOf(['configuration_only','live']));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Memories",
      "item": [
        {
          "name": "GET /api/memories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/memories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.json().memories; pm.test('array', () => pm.expect(m).to.be.an('array'));",
                  "if (m.length) { pm.collectionVariables.set('memoryId', m[0].id); pm.collectionVariables.set('memoryVersion', String(m[0].version)); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/memories?category=inventory",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/memories?category=inventory"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('only inventory', () => pm.response.json().memories.forEach(x => pm.expect(x.category).to.eql('inventory')));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/memories?category=bogus (400)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/memories?category=bogus"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 malformed_input', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('malformed_input'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/memories/:id (stale version → 409)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/memories/{{memoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"version\": 999999, \"status\": \"active\" }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 version_conflict (or 404 if no memory yet)', () => pm.expect(pm.response.code).to.be.oneOf([409, 404]));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /api/memories/:id (unconfirmed → 400)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/memories/{{memoryId}}",
            "body": {
              "mode": "raw",
              "raw": "{ \"version\": {{memoryVersion}}, \"confirmed\": false }"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Turns",
      "item": [
        {
          "name": "GET /api/turns (missing conversationId → 400)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/turns"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/turns?conversationId=",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/turns?conversationId={{conversationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 array', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().turns).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Assistant",
      "item": [
        {
          "name": "POST /api/assistant (text turn)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('clientRequestId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 or a documented 4xx/5xx', () => pm.expect([200, 401, 409, 429, 502, 503, 504]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) { const b = pm.response.json(); pm.test('schemaVersion 1', () => pm.expect(b.schemaVersion).to.eql('1')); pm.test('turnId present', () => pm.expect(b.turnId).to.be.a('string')); pm.test('ui ≤ 2, chips ≤ 4', () => { pm.expect(b.ui.length).to.be.at.most(2); pm.expect(b.suggested_actions.length).to.be.at.most(4); }); }",
                  "pm.collectionVariables.set('firstAssistantStatus', String(pm.response.code));",
                  "pm.collectionVariables.set('firstAssistantTurnId', pm.response.code === 200 ? pm.response.json().turnId : '');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assistant",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientRequestId\": \"{{clientRequestId}}\",\n  \"conversationId\": \"{{conversationId}}\",\n  \"text\": \"I'm out of tomatoes and potatoes. I'm cooking chicken curry tonight. I'm looking for running shoes.\",\n  \"inputKind\": \"text\",\n  \"timeZone\": \"America/New_York\"\n}"
            }
          }
        },
        {
          "name": "POST /api/assistant (same clientRequestId → stored response, or retry of a failed turn)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const first = Number(pm.collectionVariables.get('firstAssistantStatus'));",
                  "pm.test('replay: 200 with the same turnId when the first call succeeded, 409 while processing, or the same failure code when the first call failed', () => {",
                  "  if (first === 200) { pm.expect([200, 409]).to.include(pm.response.code); if (pm.response.code === 200) pm.expect(pm.response.json().turnId).to.eql(pm.collectionVariables.get('firstAssistantTurnId')); }",
                  "  else { pm.expect([first, 409]).to.include(pm.response.code); }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assistant",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientRequestId\": \"{{clientRequestId}}\",\n  \"conversationId\": \"{{conversationId}}\",\n  \"text\": \"I'm out of tomatoes and potatoes. I'm cooking chicken curry tonight. I'm looking for running shoes.\",\n  \"inputKind\": \"text\",\n  \"timeZone\": \"America/New_York\"\n}"
            }
          }
        },
        {
          "name": "POST /api/assistant (malformed → 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 malformed_input', () => { pm.response.to.have.status(400); pm.expect(pm.response.json().error.code).to.eql('malformed_input'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/assistant",
            "body": {
              "mode": "raw",
              "raw": "{\"clientRequestId\":\"not-a-uuid\",\"conversationId\":\"{{conversationId}}\",\"text\":\"\",\"inputKind\":\"text\",\"timeZone\":\"EST\"}"
            }
          }
        }
      ]
    }
  ]
}
