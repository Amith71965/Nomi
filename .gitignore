# ── dependencies ──
/node_modules
/.pnp
.pnp.*

# ── testing ──
/coverage
/test-results
/playwright-report

# ── next.js ──
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# ── env: keep the template, never the values ──
.env*
!.env.example

# ── private planning documents ──
# Shared with collaborators out-of-band (see README → "Planning documents").
# Never committed: these are internal execution notes, not product code.
/planning/

# ── local scratch ──
/.scratch/
/tmp/

# ── os / editor ──
.DS_Store
*.pem
.idea/
.vscode/*
!.vscode/extensions.json

# ── logs ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── hosting ──
.vercel

# ── claude code: local agent config, never committed ──
/.claude/
