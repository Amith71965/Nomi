# ──────────────────────────────────────────────────────────────────────────────
# Nomi environment template. Copy to .env (or .env.local) and fill in values.
# Never commit real values. Startup validation reports MISSING NAMES only.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ──
# Exact trusted origin, no trailing slash. Used for same-origin checks.
APP_ORIGIN=http://localhost:3000

# ── Model access via OpenRouter (OpenAI-compatible Chat Completions) ──
# Get a key at https://openrouter.ai/keys. Optional until you test the
# assistant: without it the memory/turn routes still work and /api/connections
# reports model.ready=false.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model slug. Must support tool calling + JSON schema output.
NOMI_MODEL=openai/gpt-4.1-mini
# Optional attribution headers OpenRouter recommends (HTTP-Referer / X-Title)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Nomi

# ── Voice transcription (P1, optional) ──
# OpenRouter has no speech-to-text endpoint, so voice uses a dedicated provider.
# Default is Deepgram (https://console.deepgram.com → API Keys). Set
# ENABLE_VOICE=true and paste DEEPGRAM_API_KEY. Only the selected provider's key
# is required. OpenAI stays available as an alternative (TRANSCRIPTION_PROVIDER=openai).
ENABLE_VOICE=false
TRANSCRIPTION_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ── Supabase (Dashboard → Project Settings → API) ──
# Migrations add tables, functions and policies. URL + publishable key may
# reach the browser. Accounts are public: enable email sign-ups in
# Authentication → Sign In / Providers → Email, set Site URL to APP_ORIGIN and
# add APP_ORIGIN/auth/callback to Redirect URLs so confirmation links work.
NEXT_PUBLIC_SUPABASE_URL=
# Public browser key. Fill ONE of these. Newer projects call it "publishable"
# (sb_publishable_…); older ones "anon" (a JWT starting eyJ…, role=anon).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_PUBLIC_KEY=
# SERVER ONLY. Fill ONE of these. Newer projects: "secret" key (sb_secret_…).
# Older: the "legacy service_role secret" JWT (eyJ…, role=service_role).
# Never expose in the browser or logs.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_LEGACY_SERVICE_ROLE_SECRET_KEY=

# ── Owner's smoke-test account (optional) ──
# UUID of your own test user, used only by scripts (npm run verify, api:test).
# Create one with: DEMO_EMAIL=… DEMO_PASSWORD=… npm run demo:user (writes this
# value for you). Never put the password in this file. Leave blank to skip.
DEMO_USER_ID=
# Default zone for time parsing until a per-account setting exists.
DEMO_TIME_ZONE=America/New_York

# ── Google Calendar linking (server-side OAuth client; each user links their own calendar in the app) ──
# Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application".
# Authorized redirect URI: APP_ORIGIN/api/integrations/google/callback
# Enable the Google Calendar API; add yourself as a test user while in Testing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seals users' refresh tokens at rest. 32 random bytes, base64: openssl rand -base64 32
# All three of these are required together; leave all blank to hide linking.
INTEGRATIONS_ENCRYPTION_KEY=

# ── Shopping research (SerpApi Google Shopping) ──
PRODUCT_SEARCH_API_KEY=
# OPTIONAL fallback only. Each user sets their own shopping location inside the
# app (Linked apps → Where you shop), which is where it belongs. This is used
# only for a user who has not set one. e.g. "Austin, Texas, United States"
PRODUCT_SEARCH_LOCATION=

# ── Modes ──
# live | cached | fixture. Never silently degrades; UI always shows the mode.
RESEARCH_MODE=live

# ── Google Maps (optional) ──
# Used server-side to turn what a user types ("austin tx") into a canonical
# "Austin, Texas, United States" so product search localizes. Without it their
# text is used exactly as typed and the app says it was not verified.
GOOGLE_MAPS_API_KEY=
# P2 nearby-places feature; leave false unless implemented and tested.
ENABLE_PLACES=false
